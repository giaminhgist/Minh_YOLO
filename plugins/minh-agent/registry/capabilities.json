{
  "schema_version": 1,
  "note": "Entry → workflow → resources/tools/outputs for minh-agent. This is a machine-readable routing aid read by the /minh-agent:run entry and by doctor/validator scripts — a JSON file does not by itself constrain model behavior.",
  "entries": [
    {
      "entry": "run",
      "invocation": "/minh-agent:run",
      "triggers": ["unclassified coding/research/writing/meta request", "explicit mode request"],
      "mode": "standalone (default) · workflow on explicit request only",
      "primary_workflow": "native router: classify → mode → route → tool check → execute → verify → checkpoint",
      "resources": [],
      "scripts": ["scripts/state.py"],
      "optional_dependencies": [],
      "side_effects": ["runs one primary workflow", "creates .minh-agent state only for continuation-worthy tasks"],
      "output_contract": "result of the routed workflow with verification evidence and remaining limits"
    },
    {
      "entry": "plan",
      "invocation": "/minh-agent:plan",
      "triggers": ["design/plan/spec request", "multi-step change before code"],
      "mode": "standalone",
      "primary_workflow": "brainstorming (spike/bounded/architectural) → writing-plans",
      "resources": ["resources/planning/brainstorming", "resources/planning/writing-plans"],
      "scripts": [],
      "optional_dependencies": [],
      "side_effects": ["writes docs/specs or docs/plans only", "never modifies code"],
      "output_contract": "reviewable plan/spec with per-task verification commands; no code changed"
    },
    {
      "entry": "code",
      "invocation": "/minh-agent:code",
      "triggers": ["implement feature", "refactor", "fix with concrete scope"],
      "mode": "standalone",
      "primary_workflow": "executing-plans (with plan) or direct TDD (bounded)",
      "resources": ["resources/coding/executing-plans", "resources/coding/test-driven-development",
                    "resources/debugging/systematic-debugging", "resources/verification/verification-before-completion"],
      "scripts": ["scripts/state.py"],
      "optional_dependencies": ["git (required)"],
      "side_effects": ["edits code", "runs tests", "commits per plan/request"],
      "output_contract": "code change + test evidence + report of verified vs unverified"
    },
    {
      "entry": "debug",
      "invocation": "/minh-agent:debug",
      "triggers": ["bug", "error", "test failure", "unexpected behavior"],
      "mode": "standalone",
      "primary_workflow": "systematic-debugging (4 phases)",
      "resources": ["resources/debugging/systematic-debugging",
                    "resources/coding/test-driven-development", "resources/verification/verification-before-completion"],
      "scripts": [],
      "optional_dependencies": ["git (required)"],
      "side_effects": ["reproduces bug", "fixes root cause", "adds regression test"],
      "output_contract": "root cause + evidence + fix + RED→GREEN regression proof"
    },
    {
      "entry": "review",
      "invocation": "/minh-agent:review",
      "triggers": ["review a diff/PR/branch/file", "review gate of another workflow"],
      "mode": "standalone",
      "primary_workflow": "fresh-context reviewer dispatch (requesting-code-review)",
      "resources": ["resources/reviewing/requesting-code-review"],
      "scripts": [],
      "optional_dependencies": ["subagent tool for fresh-context review"],
      "side_effects": ["none — review-only never fixes code"],
      "output_contract": "severity-ranked findings with file:line + evidence + independence label"
    },
    {
      "entry": "research",
      "invocation": "/minh-agent:research",
      "triggers": ["literature question", "novelty check", "idea development"],
      "mode": "standalone",
      "primary_workflow": "research-lit retrieval → verification → synthesis",
      "resources": ["resources/research/research-lit", "resources/research/arxiv",
                    "resources/research/semantic-scholar", "resources/ideas/novelty-check",
                    "resources/ideas/idea-creator", "resources/ideas/research-refine"],
      "scripts": [],
      "optional_dependencies": ["network access for live sources (curl)", "API keys only when user-configured"],
      "side_effects": ["none beyond saving synthesis artifacts on request"],
      "output_contract": "sourced synthesis; fact/inference/gap separated; every conclusion traced"
    },
    {
      "entry": "read",
      "invocation": "/minh-agent:read",
      "triggers": ["deep reading of a supplied paper/PDF/document"],
      "mode": "standalone",
      "primary_workflow": "deepread (5 modes, default deep)",
      "resources": ["resources/reading/deepread"],
      "scripts": [],
      "optional_dependencies": ["pdftotext for PDF extraction"],
      "side_effects": ["none"],
      "output_contract": "claims/evidence/limits from what was actually read; inaccessible docs stated"
    },
    {
      "entry": "experiment",
      "invocation": "/minh-agent:experiment",
      "triggers": ["design experiment", "plan ablations", "run local experiment", "analyze results"],
      "mode": "standalone (design default; run only on request with budget)",
      "primary_workflow": "experiment-plan → (optional) run-experiment → analyze-results → result-to-claim",
      "resources": ["resources/experiments/experiment-plan", "resources/experiments/ablation-planner",
                    "resources/experiments/run-experiment", "resources/experiments/analyze-results",
                    "resources/experiments/result-to-claim"],
      "scripts": ["resources/experiments/result-to-claim/scripts/evidence_check.py"],
      "optional_dependencies": ["project runtime (python/conda)", "GPU only with explicit user approval"],
      "side_effects": ["writes protocol docs", "on explicit run: executes, saves results + config, logs runs"],
      "output_contract": "protocol with metrics/controls/budget (design) or real saved results with seed discipline"
    },
    {
      "entry": "write",
      "invocation": "/minh-agent:write",
      "triggers": ["write/edit paper", "grant proposal", "technical document from evidence"],
      "mode": "standalone",
      "primary_workflow": "paper-plan → evidence-gated drafting (paper-write) → audits",
      "resources": ["resources/writing/paper-plan", "resources/writing/paper-write",
                    "resources/writing/paper-claim-audit", "resources/writing/citation-audit",
                    "resources/writing/ml-paper-writing", "resources/grants/grant-proposal",
                    "resources/experiments/result-to-claim"],
      "scripts": [],
      "optional_dependencies": ["pdflatex to compile", "network for citation verification"],
      "side_effects": ["writes/edits documents"],
      "output_contract": "document + evidence mapping + marked missing parts + audit results"
    },
    {
      "entry": "figure",
      "invocation": "/minh-agent:figure",
      "triggers": ["scientific figure/chart/plot from user data"],
      "mode": "standalone",
      "primary_workflow": "figure contract → backend gate → scripted plot → caption + statistics legend",
      "resources": ["resources/figures/paper-figure", "resources/figures/figure-spec",
                    "resources/figures/academic-plotting"],
      "scripts": [],
      "optional_dependencies": ["python3 + matplotlib (or R) for plotting"],
      "side_effects": ["writes figure files + reproducible script"],
      "output_contract": "figure + script + caption with statistics legend; data matches source"
    },
    {
      "entry": "resume",
      "invocation": "/minh-agent:resume",
      "triggers": ["continue previous run/task", "recover a workflow"],
      "mode": "standalone",
      "primary_workflow": "read checkpoint → reconcile with workspace → continue first unfinished step",
      "resources": ["resources/context/filesystem-context", "resources/context/context-compression"],
      "scripts": ["scripts/state.py"],
      "optional_dependencies": ["git"],
      "side_effects": ["continues the run from the checkpoint", "re-verifies stale steps"],
      "output_contract": "checkpoint vs workspace diff + continued work + explicitly unverified parts"
    },
    {
      "entry": "doctor",
      "invocation": "/minh-agent:doctor",
      "triggers": ["plugin health check", "install/update verification"],
      "mode": "standalone",
      "primary_workflow": "doctor.py structured health report",
      "resources": [],
      "scripts": ["scripts/doctor.py", "scripts/validate_registry.py"],
      "optional_dependencies": ["none — never installs or spends"],
      "side_effects": ["none"],
      "output_contract": "installable vs runtime-ready verdicts + capability degradation list"
    }
  ]
}
